		sourceColumn: customer_unique_id

	column purchase_date
		dataType: dateTime
		formatString: Short Date
		lineageTag: 649f39f7-a7f9-48ab-8f48-22594389f416
		summarizeBy: none
		sourceColumn: purchase_date

		annotation UnderlyingDateTimeDataType = Date

	column order_status
