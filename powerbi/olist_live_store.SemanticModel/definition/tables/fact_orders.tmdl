table fact_orders
	lineageTag: 13129a01-d686-4116-b4a7-f0e590b888e4

	measure Pedidos = COUNTROWS(fact_orders)
		formatString: #,0
		lineageTag: 68f18664-4876-4e9d-b2f4-ea19af74a7de

	measure Ingresos = SUM(fact_order_items[price])
		formatString: #,0.00
		lineageTag: b56b1622-4d3b-48fd-b772-334eb300d72e

	measure 'Ticket medio' = DIVIDE([Ingresos], [Pedidos])
		formatString: #,0.00
		lineageTag: c5e98321-4b98-48aa-9243-ce4eace58d99

	measure 'Pedidos hoy' = CALCULATE([Pedidos], fact_orders[purchase_date] = TODAY())
		formatString: #,0
		lineageTag: a7d2cba8-8edf-4642-835a-92b619c56975

	measure 'En camino' = CALCULATE([Pedidos], fact_orders[order_status] = "shipped")
		formatString: #,0
		lineageTag: e266d5d8-d3c1-47c5-ae0f-20bd49db16b2

	measure 'Nota media' = AVERAGE(fact_orders[review_score])
		formatString: 0.00
		lineageTag: e062b725-e9ce-4c5b-ad50-352cd3059064

	measure '% con retraso' = DIVIDE(CALCULATE([Pedidos], fact_orders[is_late] = TRUE()), CALCULATE([Pedidos], NOT ISBLANK(fact_orders[is_late])))
		formatString: 0.0%
		lineageTag: 1a5392fd-fc31-43b7-9f14-485fc417f60f

	measure 'Ingresos 30 días' = CALCULATE([Ingresos], fact_order_items[purchase_date] > TODAY() - 30, fact_order_items[purchase_date] <= TODAY())
		formatString: #,0
		lineageTag: 65f16f24-97bc-438c-bb1d-4d97346baec1

	measure 'A tiempo' = CALCULATE([Nota media], fact_orders[is_late] == FALSE())
		formatString: 0.00
		lineageTag: 65660665-f8b5-46c1-a794-f33478130044

	measure 'Con retraso' = CALCULATE([Nota media], fact_orders[is_late] = TRUE())
		formatString: 0.00
		lineageTag: 6d511ec2-acf0-4752-b5d7-0f6032263691

	column order_id
		dataType: string
		lineageTag: bdfd9765-440b-491b-9835-d389f7c719d8
