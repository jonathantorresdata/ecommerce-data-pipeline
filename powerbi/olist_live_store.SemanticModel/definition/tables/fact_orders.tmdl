		lineageTag: 3469923a-eced-4c8b-998d-d26f8269844c
		summarizeBy: sum
		sourceColumn: payment_value

	column delivery_days
		dataType: int64
		lineageTag: 5cc30943-4747-47f6-af58-fa972cac3b33
		summarizeBy: sum
		sourceColumn: delivery_days

		annotation SummarizationSetBy = Automatic

	column delay_days
		dataType: int64
		lineageTag: 233f2b72-8c3d-42a0-a07a-376e4fe379e6
		summarizeBy: sum
		sourceColumn: delay_days

		annotation SummarizationSetBy = Automatic

	column is_late
		dataType: boolean
		lineageTag: 1ddcae7c-3502-48a8-9020-f9b514e3eb5b
		summarizeBy: none
		sourceColumn: is_late

	column review_score
		dataType: double
		lineageTag: 60fc52c7-a6e6-4b66-857c-3c2fe61a52f6
		summarizeBy: sum
		sourceColumn: review_score

		annotation SummarizationSetBy = Automatic

	column is_missing_delivery_date
		dataType: boolean
		lineageTag: 755f3fc9-c540-4290-a5bc-dee9a7c1670b
		summarizeBy: none
		sourceColumn: is_missing_delivery_date

	column is_canceled_but_delivered
		dataType: boolean
		lineageTag: c05ca797-23ad-4486-af86-b5a95439c129
		summarizeBy: none
		sourceColumn: is_canceled_but_delivered

	column updated_at
		dataType: dateTime
		formatString: General Date
		lineageTag: 1ce2f793-cd4b-4165-af39-34146e8c55f6
		summarizeBy: none
		sourceColumn: updated_at

		variation Variation
			isDefault
			relationship: 81d4b134-2428-43ce-ad0c-3feda3472d09
			defaultHierarchy: LocalDateTable_edcabb66-1f16-4dcd-9b12-38ea9c1825e0.'Jerarquía de fechas'

	column 'Plazo de entrega' =
			SWITCH(
			    TRUE(),
			    ISBLANK(fact_orders[delivery_days]), BLANK(),
			    fact_orders[delivery_days] <= 7, "0-7 días",
			    fact_orders[delivery_days] <= 14, "8-14 días",
			    fact_orders[delivery_days] <= 21, "15-21 días",
			    fact_orders[delivery_days] <= 30, "22-30 días",
			    fact_orders[delivery_days] <= 45, "31-45 días",
			    "Más de 45 días"
			)
		lineageTag: 36c5ae50-e0de-4939-bd32-9f95e3eac8fa
		summarizeBy: none
		sortByColumn: 'Orden plazo'

	column 'Orden plazo' =
			SWITCH(
			    TRUE(),
			    ISBLANK(fact_orders[delivery_days]), BLANK(),
			    fact_orders[delivery_days] <= 7, 1,
			    fact_orders[delivery_days] <= 14, 2,
			    fact_orders[delivery_days] <= 21, 3,
			    fact_orders[delivery_days] <= 30, 4,
			    fact_orders[delivery_days] <= 45, 5,
			    6
			)
		isHidden
		formatString: 0
		lineageTag: 32654cc0-b37c-42cd-be9f-970aeb5379ab
		summarizeBy: none

	partition fact_orders = m
		mode: import
		source =
				let
				    Source = Databricks.Catalogs(ServerHostname, HttpPath, [Catalog=null, Database=null, EnableAutomaticProxyDiscovery=null]),
				    olist = Source{[Name="olist",Kind="Database"]}[Data],
				    gold = olist{[Name="gold",Kind="Schema"]}[Data],
				    tbl = gold{[Name="fact_orders",Kind="Table"]}[Data]
				in
				    tbl

